# pongoOS is cloned fresh at build time (CI or local), not vendored
phase2/pongo-src/

# build scratch
phase2/build/
phase2/modules/*/build/
*.o
*.Td
*.bin.tmp

# downloaded CI artifacts land here locally; keep the dir, not the contents
output/*
!output/.gitkeep

# Theos build cache/scratch -- never source, and can transiently contain
# whatever debug/test build (e.g. a temporary PIN-setting ctor) was last
# built locally. The packaged .deb under packages/ is the intentional,
# reviewed artifact; this directory never is.
**/.theos/

.DS_Store

# emulator/: the vendored xnu-qemu-arm64 QEMU fork (full upstream source
# tree, ~113MB) is cloned fresh, not committed -- same reasoning as
# phase2/pongo-src/ above. IPSW downloads, extracted kernelcache/device
# tree/disk images, and the built qemu-system-aarch64 binary are all
# local artifacts too.
emulator/xnu-qemu-arm64/
emulator/xnu-qemu-arm64-tools/
emulator/*.ipsw
emulator/*.dmg
emulator/*.dmg.out
emulator/kernelcache*
emulator/*.im4p*
# emulator/work/: scratch dir for IPSW-derived artifacts (decoded ramdisk,
# kernelcache, device tree, BuildManifest.plist) -- all re-derivable via
# remote_zip_extract.py + xnu-qemu-arm64-tools, same reasoning as above.
emulator/work/
