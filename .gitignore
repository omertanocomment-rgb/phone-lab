# pongoOS is cloned fresh at build time (CI or local), not vendored
phase2/pongo-src/

# build scratch
phase2/build/
phase2/modules/*/build/
*.o
*.bin.tmp

# downloaded CI artifacts land here locally; keep the dir, not the contents
output/*
!output/.gitkeep

# Theos build cache/scratch -- never source, and can transiently contain
# whatever debug/test build (e.g. a temporary PIN-setting ctor) was last
# built locally. The packaged .deb under packages/ is the intentional,
# reviewed artifact; this directory never is.
**/.theos/

.DS_Store
